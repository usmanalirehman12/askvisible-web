# The app runs in demo mode without these values.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Separate from ANTHROPIC_MODEL above: that one is the cross-engine check's Haiku-class
# model (high volume, cheap). This is the dashboard's Claude-powered fix generator — real
# writing quality, used for POST /api/scan's fix suggestions. Same ANTHROPIC_API_KEY covers
# both; only the model tier differs.
ANTHROPIC_FIX_MODEL=claude-sonnet-5
# Google Places API (New), not the full Google Business Profile API — a plain API-key
# lookup for public listing/review data, no business-owner OAuth consent flow required.
# Powers the GBP + reviews audit at POST /api/audit.
GOOGLE_PLACES_API_KEY=
# Score-drop alerts (lib/email). Both must be set or alerting silently no-ops — the cron
# checks emailConfigured() and skips rather than failing a scan. ALERT_FROM_EMAIL has to be
# on a domain verified in Resend, or every send comes back 403.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
